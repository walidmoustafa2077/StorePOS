<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.SettingsViews.CashierSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch"
                    Margin="12">
            <!-- POS Layout Settings Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#4CAF50"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="ViewGridOutline"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="POS Layout"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#4CAF50"/>
                            <TextBlock Text="Customize cashier interface layout and display"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Layout Mode -->
                    <TextBlock Text="Layout Mode"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <ComboBox materialDesign:HintAssist.Hint="Select cashier layout"
                             Style="{StaticResource MaterialDesignFilledComboBox}"
                             ItemsSource="{Binding LayoutModes}"
                             SelectedItem="{Binding SelectedLayoutMode}"
                             Margin="0,0,0,20"/>

                    <!-- Product Display -->
                    <TextBlock Text="Product Display Mode"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <ComboBox materialDesign:HintAssist.Hint="How products are displayed"
                             Style="{StaticResource MaterialDesignFilledComboBox}"
                             ItemsSource="{Binding ProductDisplayModes}"
                             SelectedItem="{Binding SelectedProductDisplayMode}"
                             Margin="0,0,0,20"/>

                    <!-- Grid Columns Slider -->
                    <TextBlock Text="Products Grid Columns"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Slider Grid.Column="0"
                               Minimum="2"
                               Maximum="8"
                               Value="{Binding GridColumns}"
                               TickFrequency="1"
                               TickPlacement="BottomRight"
                               IsSnapToTickEnabled="True"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                        
                        <Border Grid.Column="1"
                               Background="{DynamicResource MaterialDesign.Brush.Primary}"
                               CornerRadius="16"
                               Padding="12,6"
                               VerticalAlignment="Center">
                            <TextBlock Text="{Binding GridColumns, StringFormat={}{0} columns}"
                                      FontSize="13"
                                      FontWeight="Medium"
                                      Foreground="White"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Quick Actions Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#FF9800"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="LightningBolt"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Quick Actions"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#FF9800"/>
                            <TextBlock Text="Enable shortcuts and quick access features"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Toggle Options -->
                    <StackPanel>
                        <!-- Quick Payment -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding EnableQuickPayment}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Quick Payment Buttons"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Add buttons for common payment amounts"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <!-- Discount Button -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding ShowDiscountButton}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Show Discount Button"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Display quick discount option on cashier screen"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <!-- Barcode Scanner -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding EnableBarcodeScanner}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Enable Barcode Scanner"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Allow barcode scanning for products"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <!-- Auto-focus Search -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding AutoFocusSearch}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Auto-focus Search Box"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Automatically focus product search box after transaction"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Payment Settings Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#2196F3"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="CreditCard"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Payment Settings"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#2196F3"/>
                            <TextBlock Text="Configure payment methods and checkout options"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Toggle Options -->
                    <StackPanel>
                        <!-- Split Payment -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding AllowSplitPayment}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Allow Split Payment"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Enable customers to pay using multiple payment methods"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <!-- Calculator -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding ShowCalculator}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Show Calculator"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Display calculator for manual calculations"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <!-- Customer Name -->
                        <Grid Margin="0,12,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding AskCustomerName}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ask for Customer Name"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Prompt for customer name during checkout"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Default Payment Method -->
                        <TextBlock Text="Default Payment Method"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,8"/>
                        <ComboBox materialDesign:HintAssist.Hint="Select default payment method"
                                 Style="{StaticResource MaterialDesignFilledComboBox}"
                                 ItemsSource="{Binding PaymentMethods}"
                                 SelectedItem="{Binding DefaultPaymentMethod}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Behavior Settings Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#9C27B0"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Cog"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Behavior Settings"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#9C27B0"/>
                            <TextBlock Text="Control system behavior and automation"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Toggle Options -->
                    <StackPanel>
                        <!-- Sound on Transaction -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding SoundOnTransaction}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sound on Transaction"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Play sound effect when completing a transaction"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <!-- Auto Print Receipt -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding AutoPrintReceipt}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Auto Print Receipt"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Automatically print receipt after transaction"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <!-- Confirm Before Delete -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding ConfirmBeforeDelete}"
                                         VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Confirm Before Delete"
                                          FontSize="14"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Ask for confirmation before removing items from cart"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
