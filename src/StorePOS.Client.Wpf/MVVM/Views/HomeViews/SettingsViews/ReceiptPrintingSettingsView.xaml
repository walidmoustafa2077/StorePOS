<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.SettingsViews.ReceiptPrintingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StorePOS.Client.Wpf.Converters"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="350" MaxWidth="400"/>
        </Grid.ColumnDefinitions>


        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch"
                        Margin="12">
                <!-- POS Layout Settings Card -->
                <materialDesign:Card UniformCornerRadius="12"
                                     Margin="0,0,0,20"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    
                    <StackPanel Margin="24">
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0"
                                    Background="#2196F3"
                                    CornerRadius="12"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="Receipt"
                                                       Width="28"
                                                       Height="28"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Receipt Format"
                                          FontSize="18"
                                          FontWeight="SemiBold"
                                          Foreground="#2196F3"/>
                                <TextBlock Text="Customize receipt header, footer, and layout"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Receipt Header -->
                        <TextBlock Text="Receipt Header"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Enter header text (e.g., Thank you for shopping!)"
                                Style="{StaticResource MaterialDesignFilledTextBox}"
                                Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80"
                                Margin="0,0,0,20"/>

                        <!-- Receipt Footer -->
                        <TextBlock Text="Receipt Footer"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Enter footer text (e.g., Visit us again!)"
                                Style="{StaticResource MaterialDesignFilledTextBox}"
                                Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80"
                                Margin="0,0,0,20"/>

                        <!-- Paper Size & Font Size -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paper Size"
                                          FontSize="14"
                                          FontWeight="Medium"
                                          Margin="0,0,0,8"/>
                                <ComboBox materialDesign:HintAssist.Hint="Select paper size"
                                         Style="{StaticResource MaterialDesignFilledComboBox}"
                                         ItemsSource="{Binding PaperSizes}"
                                         SelectedItem="{Binding SelectedPaperSize}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Font Size"
                                          FontSize="14"
                                          FontWeight="Medium"
                                          Margin="0,0,0,8"/>
                                <ComboBox materialDesign:HintAssist.Hint="Select font size"
                                         Style="{StaticResource MaterialDesignFilledComboBox}"
                                         ItemsSource="{Binding ReceiptFontSizes}"
                                         SelectedItem="{Binding SelectedReceiptFontSize}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Receipt Content Card -->
                <materialDesign:Card UniformCornerRadius="12"
                                    Margin="0,0,0,20"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel Margin="24">
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0"
                                    Background="#4CAF50"
                                    CornerRadius="12"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="FormatListBulleted"
                                                       Width="28"
                                                       Height="28"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Receipt Content"
                                          FontSize="18"
                                          FontWeight="SemiBold"
                                          Foreground="#4CAF50"/>
                                <TextBlock Text="Choose what information to include"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Toggle Options -->
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                             Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                             IsChecked="{Binding ShowStoreLogo}"
                                             VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Store Logo" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="Display store logo on receipts" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12"/>

                            <Grid Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                             Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                             IsChecked="{Binding ShowStoreAddress}"
                                             VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Store Address" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="Include store address information" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12"/>

                            <Grid Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                             Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                             IsChecked="{Binding ShowTaxBreakdown}"
                                             VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Tax Breakdown" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="Display detailed tax information" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12"/>

                            <Grid Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                             Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                             IsChecked="{Binding ShowItemCodes}"
                                             VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Item Codes/SKU" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="Include product codes on receipt" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12"/>

                            <Grid Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                             Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                             IsChecked="{Binding ShowBarcode}"
                                             VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Barcode" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="Print transaction barcode for tracking" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                             Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                             IsChecked="{Binding ShowQRCode}"
                                             VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Show QR Code" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="Generate QR code for digital receipt" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Printer Settings Card -->
                <materialDesign:Card UniformCornerRadius="12"
                                    Margin="0,0,0,20"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel Margin="24">
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0"
                                    Background="#FF9800"
                                    CornerRadius="12"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="Printer"
                                                       Width="28"
                                                       Height="28"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Printer Settings"
                                          FontSize="18"
                                          FontWeight="SemiBold"
                                          Foreground="#FF9800"/>
                                <TextBlock Text="Configure printer and output options"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Default Printer -->
                        <TextBlock Text="Default Printer"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Select receipt printer"
                                     Style="{StaticResource MaterialDesignFilledComboBox}"
                                     ItemsSource="{Binding AvailablePrinters}"
                                     SelectedItem="{Binding SelectedPrinter}"
                                     Margin="0,0,12,0"/>
                            <Button Grid.Column="1"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Command="{Binding RefreshPrintersCommand}"
                                   Height="56"
                                   Padding="16,8">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                            </Button>
                        </Grid>

                        <!-- Number of Copies -->
                        <TextBlock Text="Number of Copies"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,8"/>
                        <ComboBox materialDesign:HintAssist.Hint="Select number of copies"
                                 Style="{StaticResource MaterialDesignFilledComboBox}"
                                 ItemsSource="{Binding NumberOfCopies}"
                                 SelectedItem="{Binding SelectedNumberOfCopies}"
                                 Margin="0,0,0,20"/>

                        <!-- Print Options -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding AutoCutPaper}"
                                         VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Auto-cut Paper" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="Automatically cut paper after printing" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0"
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                         IsChecked="{Binding OpenCashDrawer}"
                                         VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Open Cash Drawer" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="Trigger cash drawer to open after print" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Test Actions Card -->
                <materialDesign:Card UniformCornerRadius="12"
                                    Margin="0,0,0,20"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel Margin="24">
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0"
                                    Background="#9C27B0"
                                    CornerRadius="12"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="TestTube"
                                                       Width="28"
                                                       Height="28"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Test &amp; Actions"
                                          FontSize="18"
                                          FontWeight="SemiBold"
                                          Foreground="#9C27B0"/>
                                <TextBlock Text="Test your receipt settings"
                                          FontSize="12"
                                          Opacity="0.6"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding PrintTestReceiptCommand}"
                                Height="48"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="Print Test Receipt" FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Receipt Preview Panel (Right) -->
        <materialDesign:Card Grid.Column="2"
                            UniformCornerRadius="12"
                            Margin="0,16,16,16"
                            materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        Padding="16"
                        CornerRadius="12,12,0,0">
                    <StackPanel>
                        <TextBlock Text="📄 Receipt Preview"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Live preview of your receipt"
                                  FontSize="11"
                                  Foreground="White"
                                  Opacity="0.8"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Receipt Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16"
                            MaxWidth="280">
                        <StackPanel>
                            <!-- Store Logo Placeholder -->
                            <Border Background="#F5F5F5"
                                    CornerRadius="8"
                                    Height="60"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding ShowStoreLogo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🏪 LOGO"
                                          FontSize="24"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#999"/>
                            </Border>

                            <!-- Header Text -->
                            <TextBlock Text="{Binding ReceiptHeader}"
                                      FontSize="11"
                                      TextAlignment="Center"
                                      TextWrapping="Wrap"
                                      Foreground="#333"
                                      Margin="0,0,0,8"
                                      Visibility="{Binding ReceiptHeader, Converter={StaticResource StringToVisibilityConverter}}"/>

                            <!-- Store Address -->
                            <TextBlock FontSize="10"
                                      TextAlignment="Center"
                                      Foreground="#666"
                                      Margin="0,0,0,12"
                                      Visibility="{Binding ShowStoreAddress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="123 Main Street"/>
                                <LineBreak/>
                                <Run Text="City, State 12345"/>
                                <LineBreak/>
                                <Run Text="Tel: (555) 123-4567"/>
                            </TextBlock>

                            <Separator Margin="0,8" Background="#DDD"/>

                            <!-- Transaction Info -->
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Receipt #12345" FontSize="9" Foreground="#666"/>
                                <TextBlock Grid.Column="1" Text="10/19/2025 14:30" FontSize="9" Foreground="#666" TextAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,8" Background="#DDD"/>

                            <!-- Items -->
                            <StackPanel Margin="0,8">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2x" FontSize="10" Margin="0,0,8,0" Foreground="#333"/>
                                    <TextBlock Grid.Column="1" Text="Product Name" FontSize="10" Foreground="#333"/>
                                    <TextBlock Grid.Column="2" Text="$25.00" FontSize="10" FontWeight="Medium" Foreground="#333"/>
                                </Grid>
                                <TextBlock Text="SKU: PROD-001" 
                                          FontSize="9" 
                                          Foreground="#999"
                                          Margin="20,0,0,4"
                                          Visibility="{Binding ShowItemCodes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1x" FontSize="10" Margin="0,0,8,0" Foreground="#333"/>
                                    <TextBlock Grid.Column="1" Text="Another Item" FontSize="10" Foreground="#333"/>
                                    <TextBlock Grid.Column="2" Text="$15.00" FontSize="10" FontWeight="Medium" Foreground="#333"/>
                                </Grid>
                                <TextBlock Text="SKU: PROD-002" 
                                          FontSize="9" 
                                          Foreground="#999"
                                          Margin="20,0,0,0"
                                          Visibility="{Binding ShowItemCodes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <Separator Margin="0,8" Background="#DDD"/>

                            <!-- Totals -->
                            <StackPanel Margin="0,8">
                                <Grid Margin="0,4">
                                    <TextBlock Text="Subtotal:" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="$40.00" FontSize="10" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#333"/>
                                </Grid>
                                <Grid Margin="0,4" Visibility="{Binding ShowTaxBreakdown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tax (8.5%):" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="$3.40" FontSize="10" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#333"/>
                                </Grid>
                                <Separator Margin="0,8" Background="#333"/>
                                <Grid Margin="0,4">
                                    <TextBlock Text="TOTAL:" FontSize="12" FontWeight="Bold" Foreground="#333"/>
                                    <TextBlock Text="$43.40" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#333"/>
                                </Grid>
                            </StackPanel>

                            <Separator Margin="0,12,0,8" Background="#DDD"/>

                            <!-- Payment Info -->
                            <Grid Margin="0,4">
                                <TextBlock Text="Payment: Cash" FontSize="10" Foreground="#666"/>
                                <TextBlock Text="$50.00" FontSize="10" HorizontalAlignment="Right" Foreground="#666"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Change:" FontSize="10" Foreground="#666"/>
                                <TextBlock Text="$6.60" FontSize="10" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#333"/>
                            </Grid>

                            <!-- Barcode -->
                            <Border Background="#F5F5F5"
                                    Height="50"
                                    Margin="0,16,0,8"
                                    CornerRadius="4"
                                    Visibility="{Binding ShowBarcode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="|||||| |||| ||||||||"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#333"
                                          FontFamily="Courier New"/>
                            </Border>

                            <!-- QR Code -->
                            <Border Background="#F5F5F5"
                                    Width="80"
                                    Height="80"
                                    Margin="0,8"
                                    CornerRadius="4"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding ShowQRCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="QR"
                                          FontSize="24"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="#666"/>
                            </Border>

                            <!-- Footer Text -->
                            <TextBlock Text="{Binding ReceiptFooter}"
                                      FontSize="10"
                                      TextAlignment="Center"
                                      TextWrapping="Wrap"
                                      Foreground="#666"
                                      Margin="0,12,0,0"
                                      Visibility="{Binding ReceiptFooter, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
