<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.SettingsViews.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Modern Section Style -->
        <Style x:Key="ModernSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        
        <StackPanel HorizontalAlignment="Stretch"
                    Margin="12">

            <!-- Store Information Section -->
            <materialDesign:Card UniformCornerRadius="12"
                                Padding="28"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                CornerRadius="10"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Store" 
                                                   Width="28" 
                                                   Height="28" 
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Store Information" 
                                      Style="{StaticResource SectionHeaderStyle}"
                                      Margin="0"/>
                            <TextBlock Text="Basic details about your business"
                                      FontSize="13"
                                      Opacity="0.7"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0"
                                materialDesign:HintAssist.Hint="Store Name"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox Grid.Row="0" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Business Type"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding BusinessTypes}"
                                 SelectedItem="{Binding SelectedBusinessType}"/>

                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                materialDesign:HintAssist.Hint="Store Address"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Row="2" Grid.Column="0"
                                materialDesign:HintAssist.Hint="Contact Phone"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Row="2" Grid.Column="2"
                                materialDesign:HintAssist.Hint="Contact Email"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Regional Settings Section -->
            <materialDesign:Card UniformCornerRadius="12"
                                Padding="28"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="#4CAF50"
                                CornerRadius="10"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Earth" 
                                                   Width="28" 
                                                   Height="28" 
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Regional Settings" 
                                      Style="{StaticResource SectionHeaderStyle}"
                                      Margin="0"/>
                            <TextBlock Text="Currency, timezone, and formats"
                                      FontSize="13"
                                      Opacity="0.7"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ComboBox Grid.Row="0" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Currency"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding Currencies}"
                                 SelectedItem="{Binding SelectedCurrency}"/>

                        <ComboBox Grid.Row="0" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Time Zone"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding TimeZones}"
                                 SelectedItem="{Binding SelectedTimeZone}"/>

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Date Format"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding DateFormats}"
                                 SelectedItem="{Binding SelectedDateFormat}"/>

                        <ComboBox Grid.Row="1" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Time Format"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding TimeFormats}"
                                 SelectedItem="{Binding SelectedTimeFormat}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Appearance Section -->
            <materialDesign:Card UniformCornerRadius="12"
                                Padding="28"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="#9C27B0"
                                CornerRadius="10"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Palette" 
                                                   Width="28" 
                                                   Height="28" 
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Appearance" 
                                      Style="{StaticResource SectionHeaderStyle}"
                                      Margin="0"/>
                            <TextBlock Text="Customize the look and feel"
                                      FontSize="13"
                                      Opacity="0.7"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ComboBox Grid.Row="0" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Theme Mode"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding ThemeModes}"
                                 SelectedItem="{Binding SelectedThemeMode}"/>

                        <ComboBox Grid.Row="0" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Primary Color"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding PrimaryColors}"
                                 SelectedItem="{Binding SelectedPrimaryColor}"/>

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Font Size"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 ItemsSource="{Binding FontSizes}"
                                 SelectedItem="{Binding SelectedFontSize}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>

</UserControl>
