<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.SettingsViews.DatabaseSystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900"
             Background="Transparent">


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch"
                    Margin="12">
            <!-- POS Layout Settings Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                 Margin="0,0,0,20"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#2196F3"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Database"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Database Connection"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#2196F3"/>
                            <TextBlock Text="Configure database connection settings"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Connection String -->
                    <TextBlock Text="Connection String"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Enter database connection string"
                            Style="{StaticResource MaterialDesignFilledTextBox}"
                            Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,20"/>

                    <!-- Database Type -->
                    <TextBlock Text="Database Type"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <ComboBox materialDesign:HintAssist.Hint="Select database type"
                             Style="{StaticResource MaterialDesignFilledComboBox}"
                             ItemsSource="{Binding DatabaseTypes}"
                             SelectedItem="{Binding SelectedDatabaseType}"
                             Margin="0,0,0,20"/>

                    <!-- Test Connection -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding TestConnectionCommand}"
                                Height="48"
                                Padding="24,0"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Connection" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Test Connection" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Border Grid.Column="1"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                CornerRadius="8"
                                Padding="16"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionStatus, FallbackValue='Not tested'}"
                                      FontWeight="Medium"
                                      FontSize="13"
                                      Foreground="{Binding ConnectionStatusColor}"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Backup & Restore Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#4CAF50"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="BackupRestore"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Backup &amp; Restore"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#4CAF50"/>
                            <TextBlock Text="Manage database backups and recovery"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Warning Banner -->
                    <Border Background="#FFF3E0"
                            BorderBrush="#FF9800"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0"
                                                   Kind="AlertCircle"
                                                   Width="24"
                                                   Height="24"
                                                   Foreground="#FF9800"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1"
                                      Text="Always create backups before performing system maintenance or updates"
                                      FontSize="13"
                                      FontWeight="Medium"
                                      TextWrapping="Wrap"
                                      Foreground="#E65100"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Backup Location -->
                    <TextBlock Text="Backup Location"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                materialDesign:HintAssist.Hint="Select backup folder"
                                Style="{StaticResource MaterialDesignFilledTextBox}"
                                Text="{Binding BackupLocation, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True"
                                Margin="0,0,12,0"/>
                        <Button Grid.Column="1"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Command="{Binding BrowseBackupLocationCommand}"
                               Height="56"
                               Padding="16,8">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- Auto Backup Toggle -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding EnableAutoBackup}"
                                     VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Enable Automatic Backup" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Text="Automatically create database backups on schedule" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Backup Frequency -->
                    <TextBlock Text="Backup Frequency"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <ComboBox materialDesign:HintAssist.Hint="Select backup frequency"
                             Style="{StaticResource MaterialDesignFilledComboBox}"
                             ItemsSource="{Binding BackupFrequencies}"
                             SelectedItem="{Binding SelectedBackupFrequency}"
                             IsEnabled="{Binding EnableAutoBackup}"
                             Margin="0,0,0,24"/>

                    <!-- Backup Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding CreateBackupCommand}"
                                Height="48">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseExport" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Create Backup" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RestoreBackupCommand}"
                                Height="48">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseImport" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Restore Backup" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Data Management Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                Margin="0,0,0,20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#FF9800"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="DatabaseCog"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Data Management"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#FF9800"/>
                            <TextBlock Text="Configure data retention and optimization"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Data Retention Period -->
                    <TextBlock Text="Data Retention Period"
                              FontSize="14"
                              FontWeight="Medium"
                              Margin="0,0,0,8"/>
                    <ComboBox materialDesign:HintAssist.Hint="Select retention period"
                             Style="{StaticResource MaterialDesignFilledComboBox}"
                             ItemsSource="{Binding RetentionPeriods}"
                             SelectedItem="{Binding SelectedRetentionPeriod}"
                             Margin="0,0,0,20"/>

                    <!-- Auto Cleanup Toggle -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding AutoCleanupOldData}"
                                     VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Auto-cleanup Old Data" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Text="Automatically remove data older than retention period" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Optimize Database Button -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OptimizeDatabaseCommand}"
                            Background="#FF9800"
                            Height="48">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Optimize Database" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- System Information Card -->
            <materialDesign:Card UniformCornerRadius="12"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Margin="24">
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                Background="#9C27B0"
                                CornerRadius="12"
                                Width="48"
                                Height="48"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="InformationOutline"
                                                   Width="28"
                                                   Height="28"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="System Information"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#9C27B0"/>
                            <TextBlock Text="View application and database details"
                                      FontSize="12"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Information Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Application Version -->
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                  Text="Application Version:"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Foreground="#9C27B0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" 
                                  Text="{Binding ApplicationVersion}"
                                  FontSize="14"/>

                        <!-- Database Version -->
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                  Text="Database Version:"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Foreground="#9C27B0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" 
                                  Text="{Binding DatabaseVersion}"
                                  FontSize="14"/>

                        <!-- Database Size -->
                        <TextBlock Grid.Row="4" Grid.Column="0" 
                                  Text="Database Size:"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Foreground="#9C27B0"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" 
                                  Text="{Binding DatabaseSize}"
                                  FontSize="14"/>

                        <!-- Last Backup -->
                        <TextBlock Grid.Row="6" Grid.Column="0" 
                                  Text="Last Backup:"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Foreground="#9C27B0"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" 
                                  Text="{Binding LastBackupDate}"
                                  FontSize="14"/>

                        <!-- Installation Date -->
                        <TextBlock Grid.Row="8" Grid.Column="0" 
                                  Text="Installation Date:"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Foreground="#9C27B0"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" 
                                  Text="{Binding InstallationDate}"
                                  FontSize="14"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
