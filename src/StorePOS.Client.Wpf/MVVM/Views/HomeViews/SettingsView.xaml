<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <!-- Tab Item Style -->
        <Style x:Key="SettingsTabStyle" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignNavigationRailTabItem}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0 4"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="SettingsCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <materialDesign:Card Grid.Row="0" 
                            Style="{StaticResource SettingsCardStyle}"
                            Margin="16,16,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <Border Grid.Column="0"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="12"
                        Width="56" 
                        Height="56"
                        Margin="0,0,20,0">
                    <materialDesign:PackIcon Kind="Cog" 
                                           Width="32" 
                                           Height="32"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" 
                           VerticalAlignment="Center">
                    <TextBlock Text="Settings" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock Text="Configure your store and system preferences" 
                              FontSize="14"
                              Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                              Opacity="0.6"
                              Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding SaveAllCommand}"
                            Margin="0,0,8,0"
                            Padding="16,8"
                            Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" 
                                                   Width="18" 
                                                   Height="18" 
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Save All"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ResetCommand}"
                            Padding="16,8"
                            Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" 
                                                   Width="18" 
                                                   Height="18" 
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Reset"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Settings Tabs -->
        <materialDesign:Card Grid.Row="1" 
                            Style="{StaticResource SettingsCardStyle}">
            <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                       SelectedIndex="{Binding SelectedTabIndex}">
                
                <!-- General Settings Tab -->
                <TabItem Style="{StaticResource SettingsTabStyle}">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Settings" 
                                                   Width="24" 
                                                   Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                            <TextBlock Text="General" 
                                      FontSize="11"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Margin="12" Content="{Binding CurrentSettingsContent}"/>
                </TabItem>

                <!-- Cashier Settings Tab -->
                <TabItem Style="{StaticResource SettingsTabStyle}">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="CashRegister" 
                                                   Width="24" 
                                                   Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                            <TextBlock Text="Cashier" 
                                      FontSize="11"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Margin="12" Content="{Binding CurrentSettingsContent}"/>
                </TabItem>

                <!-- Receipt & Printing Tab -->
                <TabItem Style="{StaticResource SettingsTabStyle}">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Printer" 
                                                   Width="24" 
                                                   Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                            <TextBlock Text="Printing" 
                                      FontSize="11"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Margin="12" Content="{Binding CurrentSettingsContent}"/>
                </TabItem>

                <!-- Database & System Tab -->
                <TabItem Style="{StaticResource SettingsTabStyle}">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Database" 
                                                   Width="24" 
                                                   Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                            <TextBlock Text="Database" 
                                      FontSize="11"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Margin="12" Content="{Binding CurrentSettingsContent}"/>
                </TabItem>

                <!-- Users & Security Tab -->
                <TabItem Style="{StaticResource SettingsTabStyle}">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Security" 
                                                   Width="24" 
                                                   Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                            <TextBlock Text="Security" 
                                      FontSize="11"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Margin="12" Content="{Binding CurrentSettingsContent}"/>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>
