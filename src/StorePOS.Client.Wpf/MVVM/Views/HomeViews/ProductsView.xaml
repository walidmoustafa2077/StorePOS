<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StorePOS.Client.Wpf.Converters"
             xmlns:behaviors="clr-namespace:StorePOS.Client.Wpf.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ResponsiveColumnsConverter x:Key="ResponsiveColumnsConverter" 
                                               MinColumnWidth="280" 
                                               MinColumns="1" 
                                               MaxColumns="6" />

        <!-- Product Card Style -->
        <Style x:Key="ProductCardStyle"
               TargetType="materialDesign:Card">
            <Setter Property="Margin"
                    Value="8" />
            <Setter Property="materialDesign:ElevationAssist.Elevation"
                    Value="Dp2" />
            <Setter Property="Background"
                    Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation"
                            Value="Dp4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Button Style -->
        <Style x:Key="CategoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Margin"
                    Value="4,0" />
            <Setter Property="Padding"
                    Value="16,8" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="Medium" />
        </Style>

        <!-- Filter ComboBox Style -->
        <Style x:Key="FilterComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Margin"
                    Value="8,0" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="MinWidth"
                    Value="120" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  Margin="16,8,16,16">
        <i:Interaction.Behaviors>
            <behaviors:InfiniteScrollBehavior 
                Command="{Binding LoadMoreCommand}"
                IsLoading="{Binding IsLoadingMore}"
                Threshold="200" />
        </i:Interaction.Behaviors>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header with Search and Actions -->
            <materialDesign:Card Grid.Row="0"
                                 Margin="16,16,16,8"
                                 Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Bar -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search products by name, SKU, brand..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="14"
                             Margin="0,0,16,0">
                        <i:Interaction.Behaviors>
                            <behaviors:SelectAllTextOnFocusBehavior />
                        </i:Interaction.Behaviors>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="Clear Search"
                                Margin="4,0">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="20"
                                                     Height="20" />
                        </Button>

                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Summary Stats -->
            <Grid Grid.Row="1"
                  Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0"
                                     Style="{StaticResource ProductCardStyle}"
                                     Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Package"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                 Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TotalProducts}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Total Products"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1"
                                     Style="{StaticResource ProductCardStyle}"
                                     Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Filter"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                 Margin="0,0,0,8" />
                        <TextBlock Text="{Binding FilteredProductsCount}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Filtered"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2"
                                     Style="{StaticResource ProductCardStyle}"
                                     Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="CurrencyUsd"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#4CAF50"
                                                 Margin="0,0,0,8" />
                        <TextBlock Text="{Binding FormattedInventoryValue}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Inventory Value"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3"
                                     Style="{StaticResource ProductCardStyle}"
                                     Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="AlertCircle"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#FF9800"
                                                 Margin="0,0,0,8" />
                        <TextBlock Text="{Binding LowStockCount}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Low Stock"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="4"
                                     Style="{StaticResource ProductCardStyle}"
                                     Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Alert"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#F44336"
                                                 Margin="0,0,0,8" />
                        <TextBlock Text="{Binding OutOfStockCount}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Out of Stock"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Filters -->
            <materialDesign:Card Grid.Row="2"
                                 Margin="16,8"
                                 Padding="16">
                <StackPanel>
                    <!-- Categories -->
                    <TextBlock Text="Categories"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,12">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource CategoryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Additional Filters -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding PriceRanges}"
                                  SelectedItem="{Binding SelectedPriceRange}"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  Padding="8 2"
                                  materialDesign:HintAssist.Hint="Price Range" />

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StockStatuses}"
                                  SelectedItem="{Binding SelectedStockStatus}"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  Padding="8 2"
                                  materialDesign:HintAssist.Hint="Stock Status" />

                        <CheckBox Grid.Column="2"
                                  IsChecked="{Binding ShowActiveOnly}"
                                  Content="Active Only"
                                  Margin="16,8"
                                  Padding="8 2"
                                  VerticalAlignment="Center" />

                        <Button Grid.Column="4"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ClearFiltersCommand}"
                                Height="36"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterRemove"
                                                         Width="16"
                                                         Height="16"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="Clear Filters" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Products Grid -->
            <Border Grid.Row="3" x:Name="ProductsContainer" Padding="8 0">
                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, ElementName=ProductsContainer, Converter={StaticResource ResponsiveColumnsConverter}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
            
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Style="{StaticResource ProductCardStyle}">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="12"
                                        MinHeight="320"
                                        Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="160" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0">
                                            <Grid>
                                                <!-- Placeholder for image -->
                                                <Image Source="{Binding DisplayImageUrl}"
                                                       MaxWidth="300"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="8" />
                                                
                                                <!-- Stock Status Badge -->
                                                <Border Background="{Binding StockStatusColor}"
                                                        CornerRadius="12"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="8">
                                                    <TextBlock Text="{Binding StockStatus}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>

                                                <!-- Discount Badge -->
                                                <Border Background="#F44336"
                                                        CornerRadius="12"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Discount, StringFormat={}-{0}%}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Product Details -->
                                        <StackPanel Grid.Row="1"
                                                    Margin="16">
                                            <!-- Name and Brand -->
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Brand}"
                                                       FontSize="12"
                                                       Opacity="0.7"
                                                       Margin="0,0,0,8" />

                                            <!-- Price -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FormattedPrice}"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                    <TextBlock Text="{Binding FormattedDiscountedPrice}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="#4CAF50"
                                                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding StockQuantity, StringFormat=Stock: {0}}"
                                                           FontSize="12"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Bottom" />
                                            </Grid>

                                            <!-- SKU and Category -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SKU}"
                                                           FontSize="11"
                                                           Opacity="0.6" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Category}"
                                                           FontSize="11"
                                                           Opacity="0.6"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Empty State -->
            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredProductsCount}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <materialDesign:PackIcon Kind="PackageVariant"
                                         Width="64"
                                         Height="64"
                                         Foreground="#BDBDBD"
                                         Margin="0,0,0,16" />
                <TextBlock Text="No products found"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Try adjusting your search or filters"
                           FontSize="14"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
    
</UserControl>