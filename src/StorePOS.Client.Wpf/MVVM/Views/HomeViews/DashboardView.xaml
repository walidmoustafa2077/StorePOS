<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StorePOS.Client.Wpf.MVVM.Views.HomeViews"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StorePOS.Client.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <!-- Card Style -->
        <Style x:Key="DashboardCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}"/>
        </Style>

        <!-- Header Text Style -->
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </Style>

        <!-- Value Text Style -->
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
        </Style>

        <!-- Small Value Text Style -->
        <Style x:Key="SmallValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
        </Style>

        <!-- Label Text Style -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Current Shift Summary -->
            <materialDesign:Card Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="8,8,8,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header Section -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon and Title -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                CornerRadius="12"
                                Width="56" Height="56"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="ClockTimeEight" 
                                                   Width="32" Height="32"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Current Shift" 
                                          FontSize="20" 
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <Border CornerRadius="10"
                                       Padding="8,4"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShiftActive}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#F44336"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShiftActive}" Value="True">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11" 
                                                  FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="INACTIVE"/>
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShiftActive}" Value="True">
                                                            <Setter Property="Text" Value="ACTIVE"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Monitor and manage your current work session" 
                                      FontSize="13"
                                      Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                      Opacity="0.6"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Content Section -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shift Details - Left Side -->
                        <StackPanel Grid.Column="0" 
                                   Visibility="{Binding IsShiftActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="SHIFT INFORMATION" 
                                      FontSize="11" 
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                      Margin="0,0,0,12"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Pound" 
                                                       Width="18" Height="18"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Shift Number" 
                                              FontSize="11"
                                              Opacity="0.6"/>
                                    <TextBlock Text="{Binding CurrentShift.ShiftNumber}" 
                                              FontSize="16"
                                              FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Account" 
                                                       Width="18" Height="18"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Cashier" 
                                              FontSize="11"
                                              Opacity="0.6"/>
                                    <TextBlock Text="{Binding CurrentShift.CashierName}" 
                                              FontSize="16"
                                              FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline" 
                                                       Width="18" Height="18"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Started At" 
                                              FontSize="11"
                                              Opacity="0.6"/>
                                    <TextBlock Text="{Binding CurrentShift.StartTime, StringFormat='hh:mm tt'}" 
                                              FontSize="16"
                                              FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- No Active Shift Message -->
                        <StackPanel Grid.Column="0" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Grid.ColumnSpan="3">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShiftActive}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <materialDesign:PackIcon Kind="ClockAlertOutline" 
                                                   Width="48" Height="48"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                   Opacity="0.3"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,12"/>
                            <TextBlock Text="No Active Shift" 
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      Opacity="0.7"/>
                            <TextBlock Text="Start a shift to begin tracking transactions and operations" 
                                      FontSize="13"
                                      HorizontalAlignment="Center"
                                      Opacity="0.5"
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"
                                      MaxWidth="300"
                                      Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Grid.Column="1" 
                               Width="1" 
                               Background="{DynamicResource MaterialDesign.Brush.Foreground}"
                               Opacity="0.1"
                               Margin="32,0"
                               Visibility="{Binding IsShiftActive, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Statistics - Right Side -->
                        <Grid Grid.Column="2"
                             Visibility="{Binding IsShiftActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="PERFORMANCE" 
                                      FontSize="11" 
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                      Margin="0,0,0,12"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <!-- Transactions Count -->
                                <Border Background="#F5F5F5"
                                       CornerRadius="12"
                                       Padding="16,12"
                                       Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                               CornerRadius="8"
                                               Width="40" Height="40"
                                               Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="Receipt" 
                                                                   Width="20" Height="20"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentShift.TransactionCount}" 
                                                      FontSize="24"
                                                      FontWeight="Bold"
                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <TextBlock Text="Transactions" 
                                                      FontSize="12"
                                                      Opacity="0.6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Balance Change -->
                                <Border Background="#E8F5E9"
                                       CornerRadius="12"
                                       Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#4CAF50"
                                               CornerRadius="8"
                                               Width="40" Height="40"
                                               Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="TrendingUp" 
                                                                   Width="20" Height="20"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentShift.FormattedCurrentBalance}" 
                                                      FontSize="20"
                                                      FontWeight="Bold"
                                                      Foreground="#4CAF50"/>
                                            <TextBlock Text="Balance Change" 
                                                      FontSize="12"
                                                      Foreground="#2E7D32"
                                                      Opacity="0.8"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Action Buttons -->
                    <Border Grid.Row="2" 
                           Background="{DynamicResource MaterialDesign.Brush.Background}"
                           BorderBrush="{DynamicResource MaterialDesign.Brush.Foreground}"
                           BorderThickness="0,1,0,0"
                            CornerRadius="0 0 12 12"
                           Padding="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding StartShiftCommand}"
                                    Margin="0,0,8,0"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Start Shift"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding EndShiftCommand}"
                                    Margin="0,0,8,0"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="End Shift"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding CashDropCommand}"
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsShiftActive}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrayArrowDown" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cash Drop"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding CashAddCommand}"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsShiftActive}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add Cash"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- Quick Stats Row -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Balance Card -->
                <materialDesign:Card Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Wallet" 
                                                   Width="20" Height="20" 
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Total Balance" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FormattedTotalBalance}" Style="{StaticResource SmallValueTextStyle}"/>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} active wallets">
                                    <Binding Path="ActiveWalletsCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Today's Revenue Card -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="TrendingUp" 
                                                   Width="20" Height="20" 
                                                   Foreground="#4CAF50"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Today's Sales" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FormattedTodayRevenue}" Style="{StaticResource SmallValueTextStyle}"/>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} transactions">
                                    <Binding Path="TodayTransactionsCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Cash Flow Card -->
                <materialDesign:Card Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="{Binding CashFlowSummary.NetCashFlowIcon}" 
                                                   Width="20" Height="20" 
                                                   Foreground="{Binding CashFlowSummary.NetCashFlowColor}"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Net Cash Flow" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CashFlowSummary.FormattedNetCashFlow}" 
                                  Style="{StaticResource SmallValueTextStyle}"
                                  Foreground="{Binding CashFlowSummary.NetCashFlowColor}"/>
                        <TextBlock Text="Today" Style="{StaticResource LabelTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Current Balance Card -->
                <materialDesign:Card Grid.Column="3" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Cash" 
                                                   Width="20" Height="20" 
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Current Till" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FormattedCurrentTillBalance}" 
                                  Style="{StaticResource SmallValueTextStyle}"/>
                        <TextBlock Text="In register" Style="{StaticResource LabelTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Main Content Row -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Wallets Card -->
                <materialDesign:Card Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="8,8,4,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="Wallet" 
                                                   Width="24" Height="24" 
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Account Balances" Style="{StaticResource CardHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Wallets}" MaxHeight="300">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" 
                                           Padding="8" 
                                           Margin="0,0,0,8"
                                           CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0" 
                                                                   Kind="{Binding Icon}" 
                                                                   Width="20" Height="20" 
                                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Medium" FontSize="14"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" 
                                                      Text="{Binding FormattedBalance}" 
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0"/>

                                            <Ellipse Grid.Column="3" 
                                                    Width="8" Height="8" 
                                                    Fill="{Binding StatusColor}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Recent Transactions Card -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="4,8,8,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="Receipt" 
                                                   Width="24" Height="24" 
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Recent Transactions" Style="{StaticResource CardHeaderStyle}" Margin="0"/>
                        </StackPanel>

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" 
                                               Padding="8" 
                                               Margin="0,0,0,4"
                                               CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0" 
                                                                       Kind="{Binding TypeIcon}" 
                                                                       Width="16" Height="16" 
                                                                       Foreground="{Binding StatusColor}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Description}" 
                                                              FontWeight="Medium" 
                                                              FontSize="13"
                                                              TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CustomerName}" 
                                                                  Style="{StaticResource LabelTextStyle}" 
                                                                  FontSize="11"/>
                                                        <TextBlock Text=" • " 
                                                                  Style="{StaticResource LabelTextStyle}" 
                                                                  FontSize="11"/>
                                                        <TextBlock Text="{Binding PaymentMethod}" 
                                                                  Style="{StaticResource LabelTextStyle}" 
                                                                  FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FormattedAmount}" 
                                                              FontWeight="SemiBold"
                                                              FontSize="13"
                                                              HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FormattedTime}" 
                                                              Style="{StaticResource LabelTextStyle}"
                                                              FontSize="10"
                                                              HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <Ellipse Grid.Column="3" 
                                                        Width="6" Height="6" 
                                                        Fill="{Binding StatusColor}"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Cash Flow Details Card -->
            <materialDesign:Card Grid.Row="3" Style="{StaticResource DashboardCardStyle}" Margin="8,8,8,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="ChartLine" 
                                               Width="24" Height="24" 
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Cash Flow Details" Style="{StaticResource CardHeaderStyle}" Margin="0"/>
                        <TextBlock Text="(Today)" 
                                  Style="{StaticResource LabelTextStyle}" 
                                  VerticalAlignment="Bottom"
                                  Margin="8,0,0,2"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CashFlowSummary.TotalIncome, StringFormat=C}" 
                                      Style="{StaticResource SmallValueTextStyle}"
                                      Foreground="#4CAF50"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Income" 
                                      Style="{StaticResource LabelTextStyle}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CashFlowSummary.TotalExpenses, StringFormat=C}" 
                                      Style="{StaticResource SmallValueTextStyle}"
                                      Foreground="#F44336"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Expenses" 
                                      Style="{StaticResource LabelTextStyle}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CashFlowSummary.FormattedNetCashFlow}" 
                                      Style="{StaticResource SmallValueTextStyle}"
                                      Foreground="{Binding CashFlowSummary.NetCashFlowColor}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Net Cash Flow" 
                                      Style="{StaticResource LabelTextStyle}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding CashFlowItems}" MaxHeight="200">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" 
                                       Padding="8" 
                                       Margin="0,0,0,4"
                                       CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0" 
                                                               Kind="{Binding Icon}" 
                                                               Width="18" Height="18" 
                                                               Foreground="{Binding TypeColor}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Category}" FontWeight="Medium" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" 
                                                      Style="{StaticResource LabelTextStyle}" 
                                                      FontSize="12"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" 
                                                  Text="{Binding FormattedAmount}" 
                                                  FontWeight="SemiBold"
                                                  Foreground="{Binding TypeColor}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0"/>

                                        <TextBlock Grid.Column="3" 
                                                  Text="{Binding Date, StringFormat=HH:mm}" 
                                                  Style="{StaticResource LabelTextStyle}"
                                                  VerticalAlignment="Center"
                                                  FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>