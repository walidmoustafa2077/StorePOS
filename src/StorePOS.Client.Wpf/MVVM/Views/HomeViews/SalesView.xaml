<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.HomeViews.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StorePOS.Client.Wpf.Converters"
             xmlns:behaviors="clr-namespace:StorePOS.Client.Wpf.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IndexToNumberConverter x:Key="IndexToNumberConverter" />

        <!-- DataGrid Cell Style -->
        <Style x:Key="DataGridCellCenterStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Date Range Filter (applies to both tabs) -->
        <materialDesign:Card Grid.Row="0"
                             Margin="0,0,0,16"
                             Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="CalendarRange"
                                             Width="20"
                                             Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="Date Range:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <DatePicker Grid.Column="1"
                            SelectedDate="{Binding StartDate}"
                            materialDesign:HintAssist.Hint="From Date"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Width="150"
                            Margin="0,0,8,0" />

                <DatePicker Grid.Column="2"
                            SelectedDate="{Binding EndDate}"
                            materialDesign:HintAssist.Hint="To Date"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Width="150"
                            Margin="0,0,8,0" />
            </Grid>
        </materialDesign:Card>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            <!-- Tab 1: Sales List -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="Auto" Height="Auto">
                        <materialDesign:PackIcon Width="24" Height="24"
                                                 HorizontalAlignment="Center"
                                                 Kind="ShoppingBasket" />
                        <TextBlock HorizontalAlignment="Center"
                                   Text="Sales List" />
                    </StackPanel>
                </TabItem.Header>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header with Search and Actions -->
                    <materialDesign:Card Grid.Row="0"
                                     Margin="0,0,0,8"
                                     Padding="16 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Bar -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search sales by sale number, customer, cashier, or product..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="14"
                         Margin="0,0,16,0">
                    <i:Interaction.Behaviors>
                        <behaviors:SelectAllTextOnFocusBehavior />
                    </i:Interaction.Behaviors>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="Clear Search"
                            Margin="4,0">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="20"
                                                 Height="20" />
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding PrintSalesReportCommand}"
                            Height="40"
                            Padding="16,8"
                            Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Print Report" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ExportSalesCommand}"
                            Height="40"
                            Padding="16,8"
                            Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Export"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Export" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

                <!-- Sales DataGrid -->
                <materialDesign:Card Grid.Row="1"
                                     Margin="0"
                                     Padding="12">
                    <Grid>
                        <DataGrid x:Name="SalesDataGrid"
                          ItemsSource="{Binding FilteredSales}"
                          SelectedItem="{Binding SelectedSale}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          HeadersVisibility="All"
                          GridLinesVisibility="Horizontal"
                          materialDesign:DataGridAssist.CellPadding="8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="10"
                          AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Background.Light}"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>
                        <!-- Sale Number Column -->
                        <DataGridTextColumn Header="Sale #"
                                            Binding="{Binding SaleNumber}"
                                            Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="TextAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Date Column -->
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding FormattedSaleDate}"
                                            Width="160">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="TextAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Customer Column -->
                        <DataGridTextColumn Header="Customer"
                                            Binding="{Binding CustomerName}"
                                            Width="*"
                                            MinWidth="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="TextAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cashier Column -->
                        <DataGridTextColumn Header="Cashier"
                                            Binding="{Binding CashierName}"
                                            Width="*"
                                            MinWidth="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="TextAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Payment Method Column -->
                        <DataGridTextColumn Header="Payment"
                                            Binding="{Binding PaymentMethod}"
                                            Width="100">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="TextAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total Amount Column -->
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding FormattedTotalAmount}"
                                            Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="Foreground"
                                            Value="#4CAF50" />
                                    <Setter Property="TextAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Status"
                                                Width="140"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12"
                                            Padding="8,4"
                                            MaxHeight="22"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="#4CAF50" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRefunded}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#F44336" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPartiallyRefunded}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#FF9800" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RefundStatus}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Actions"
                                                Width="220"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.ViewSaleDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="View Details"
                                                Width="32"
                                                Height="32"
                                                Margin="2,0">
                                            <materialDesign:PackIcon Kind="Eye"
                                                                     Width="18"
                                                                     Height="18" />
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Print Receipt"
                                                Width="32"
                                                Height="32"
                                                Margin="2,0">
                                            <materialDesign:PackIcon Kind="Printer"
                                                                     Width="18"
                                                                     Height="18" />
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.ProcessRefundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Process Refund"
                                                Width="32"
                                                Height="32"
                                                Margin="2,0"
                                                Foreground="#FF9800">
                                            <materialDesign:PackIcon Kind="CashRefund"
                                                                     Width="18"
                                                                     Height="18" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                             Width="64"
                                             Height="64"
                                             Foreground="#BDBDBD"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,16" />
                    <TextBlock Text="No sales found"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Try adjusting your search or date range"
                               FontSize="14"
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

            </Grid>
                </materialDesign:Card>
            </Grid>
        </TabItem>

        <!-- Tab 2: Analytics -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Width="Auto" Height="Auto">
                    <materialDesign:PackIcon Width="24" Height="24"
                                             HorizontalAlignment="Center"
                                             Kind="ChartLine" />
                    <TextBlock HorizontalAlignment="Center"
                               Text="Analytics" />
                </StackPanel>
            </TabItem.Header>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- Summary Stats -->
                <materialDesign:Card Grid.Column="0"
                                     Margin="0,0,8,0"
                                     Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBox"
                                                         Width="22"
                                                         Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="Summary Statistics"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Stats Grid -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Total Sales -->
                                <Border Grid.Row="0"
                                    Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                                    CornerRadius="8"
                                    Padding="16 4"
                                    Margin="0,8,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                            CornerRadius="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="Receipt"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalSalesCount}"
                                                   FontSize="24"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Total Sales"
                                                   FontSize="12"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Total Revenue -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                                    CornerRadius="8"
                                    Padding="16 4"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Background="#4CAF50"
                                            CornerRadius="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="CurrencyUsd"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedTotalRevenue}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#4CAF50" />
                                        <TextBlock Text="Total Revenue"
                                                   FontSize="12"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Average Sale -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                                    CornerRadius="8"
                                    Padding="16 4"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Background="#2196F3"
                                            CornerRadius="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="ChartLine"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedAverageSaleAmount}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#2196F3" />
                                        <TextBlock Text="Average Sale"
                                                   FontSize="12"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Total Items Sold -->
                            <Border Grid.Row="3"
                                    Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                                    CornerRadius="8"
                                    Padding="16 4"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Background="#FF9800"
                                            CornerRadius="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalItemsSold}"
                                                   FontSize="20"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Items Sold"
                                                   FontSize="12"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Total Refunds -->
                            <Border Grid.Row="4"
                                    Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                                    CornerRadius="8"
                                    Padding="16 4"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Background="#F44336"
                                            CornerRadius="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="CashRefund"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#F44336">
                                            <Run Text="{Binding TotalRefundsCount, Mode=OneWay}" />
                                            <Run Text="(" FontSize="14" />
                                            <Run Text="{Binding FormattedTotalRefundAmount, Mode=OneWay}" FontSize="14" />
                                            <Run Text=")" FontSize="14" />
                                        </TextBlock>
                                        <TextBlock Text="Total Refunds"
                                                   FontSize="12"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Refund Breakdown -->
                            <Border Grid.Row="5"
                                    Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                                    CornerRadius="8"
                                    Padding="16 4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Background="#9C27B0"
                                            CornerRadius="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="ChartDonut"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold">
                                            <Run Text="{Binding PartialRefundsCount, Mode=OneWay}" />
                                            <Run Text="Partial |" />
                                            <Run Text="{Binding FullRefundsCount, Mode=OneWay}" />
                                            <Run Text="Full" />
                                        </TextBlock>
                                        <TextBlock Text="Refund Breakdown"
                                                   FontSize="12"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    </Grid>
                </materialDesign:Card>

                <!-- Top Selling Products -->
                <materialDesign:Card Grid.Column="1"
                                     Margin="8,0,0,0"
                                     Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrendingUp"
                                                         Width="22"
                                                         Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="Top Selling Products"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Products List -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopSellingProducts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding TopSellingProducts}"
                                          Margin="12,8,12,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="0,6,0,8"
                                                             Padding="12"
                                                             UniformCornerRadius="8"
                                                             Background="{DynamicResource MaterialDesign.Brush.Background.Light}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Rank Badge -->
                                                <Border Grid.Row="0"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        CornerRadius="16"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Rank}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Product Name -->
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding ProductName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- Revenue -->
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="2"
                                                           Text="{Binding TotalRevenue, StringFormat=C}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#4CAF50"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />

                                                <!-- Quantity Sold -->
                                                <StackPanel Grid.Row="1"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Margin="0,4,0,0">
                                                    <materialDesign:PackIcon Kind="Package"
                                                                             Width="16"
                                                                             Height="16"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                             Margin="0,0,4,0" />
                                                    <TextBlock FontSize="12"
                                                               Opacity="0.8"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{Binding QuantitySold, Mode=OneWay}" />
                                                        <Run Text="units sold" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State for Top Selling -->
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopSellingProducts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="ChartBoxOutline"
                                                 Width="48"
                                                 Height="48"
                                                 Opacity="0.3"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,8" />
                        <TextBlock Text="No sales data available"
                                   FontSize="13"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="for the selected period"
                                   FontSize="11"
                                   Opacity="0.4"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</UserControl>
