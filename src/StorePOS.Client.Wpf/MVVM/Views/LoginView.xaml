<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:StorePOS.Client.Wpf.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d">

    <materialDesign:Card VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="20"
                         Padding="40" 
                         MinWidth="400"
                         Effect="{StaticResource MaterialDesignShadowDepth3}"
                         UniformCornerRadius="12">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="StorePOS"
                       Style="{DynamicResource MaterialDesignHeadline4TextBlock}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

            <TextBlock Text="Please sign in to continue"
                       Style="{DynamicResource MaterialDesignBody1TextBlock}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />

            <!-- Username Field -->
            <Grid Margin="0,0,0,20">
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Username"
                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                         FontSize="16"
                         Padding="40,16,16,16">
                    <i:Interaction.Behaviors>
                        <behaviors:SelectAllTextOnFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
                <materialDesign:PackIcon Kind="Account"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Margin="12,0,0,0"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         Width="20" Height="20" />
            </Grid>

            <!-- Password Field -->
            <Grid Margin="0,0,0,30">
                <PasswordBox materialDesign:HintAssist.Hint="Password"
                             materialDesign:PasswordBoxAssist.Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource MaterialDesignRevealPasswordBox}"
                             FontSize="16"
                             Padding="40,16,16,16" />
                <materialDesign:PackIcon Kind="Lock"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Margin="12,0,0,0"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         Width="20" Height="20" />
            </Grid>

            <!-- Login Button -->
            <Button Command="{Binding LoginCommand}"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Height="50"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Login"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <TextBlock Text="SIGN IN"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <TextBlock Text="SIGNING IN..."
                               VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Button>

            <!-- Copyright -->
            <TextBlock Text="© 2025 StorePOS. All rights reserved."
                       Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Opacity="0.7" />
        </StackPanel>
    </materialDesign:Card>
</UserControl>