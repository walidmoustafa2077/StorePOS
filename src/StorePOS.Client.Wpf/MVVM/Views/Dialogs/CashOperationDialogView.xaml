<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.CashOperationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StorePOS.Client.Wpf.Converters"
             xmlns:behaviors="clr-namespace:StorePOS.Client.Wpf.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="450"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,4">
                <materialDesign:PackIcon Width="24"
                                         Height="24"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind"
                                    Value="Cash" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OperationType}"
                                             Value="Drop">
                                    <Setter Property="Kind"
                                            Value="TrayArrowDown" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OperationType}"
                                             Value="Add">
                                    <Setter Property="Kind"
                                            Value="Plus" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding OperationType, StringFormat='Enter the amount to {0} and select the account:'}"
                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Form Content -->
        <StackPanel Grid.Row="2">

            <!-- Amount Input -->
            <materialDesign:Card Padding="12"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Amount"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="$"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                        <TextBox Grid.Column="1"
                                 x:Name="AmountTextBox"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="16"
                                 FontWeight="Medium"
                                 HorizontalContentAlignment="Right"
                                 Margin="0,0,6,0">
                            <i:Interaction.Behaviors>
                                <behaviors:SelectAllTextOnFocusBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>

                        <Button Grid.Column="2"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Clear amount"
                                Command="{Binding ClearAmountCommand}"
                                Width="28"
                                Height="28">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="14"
                                                     Height="14" />
                        </Button>
                    </Grid>

                    <!-- Amount validation -->
                    <TextBlock Text="{Binding AmountValidationMessage}"
                               Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,4,0,0"
                               Visibility="{Binding IsValidAmount, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <!-- Amount suggestions -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <TextBlock Text="Quick amounts:"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <Button Content="$10"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding SetQuickAmountCommand}"
                                CommandParameter="10"
                                Margin="0,0,3,0"
                                Padding="6,3" />
                        <Button Content="$20"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding SetQuickAmountCommand}"
                                CommandParameter="20"
                                Margin="0,0,3,0"
                                Padding="6,3" />
                        <Button Content="$50"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding SetQuickAmountCommand}"
                                CommandParameter="50"
                                Margin="0,0,3,0"
                                Padding="6,3" />
                        <Button Content="$100"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding SetQuickAmountCommand}"
                                CommandParameter="100"
                                Padding="6,3" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Account Selection -->
            <materialDesign:Card Padding="12"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Account"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,6" />

                    <ComboBox ItemsSource="{Binding AvailableWallets}"
                              SelectedItem="{Binding SelectedWallet}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Select account"
                              FontSize="13">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="{Binding Icon}"
                                                             Width="18"
                                                             Height="18"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Medium"
                                                   FontSize="13" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedBalance}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </materialDesign:Card>

            <!-- Reason (Optional) -->
            <materialDesign:Card Padding="12"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="Reason (Optional)"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,6" />

                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Enter reason for this operation"
                             MaxLength="100"
                             Margin="0,0,0,12"
                             AcceptsReturn="False">
                        <i:Interaction.Behaviors>
                            <behaviors:SelectAllTextOnFocusBehavior />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{Binding SecondaryButtonText}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,6,0"
                    Padding="16,6"
                    MinWidth="80" />

            <Button Content="{Binding PrimaryButtonText}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    Padding="16,6"
                    MinWidth="80">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OperationType}"
                                         Value="Drop">
                                <Setter Property="Background"
                                        Value="#FF6B46" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OperationType}"
                                         Value="Add">
                                <Setter Property="Background"
                                        Value="#4CAF50" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>