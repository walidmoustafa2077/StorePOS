<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.RefundSuccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            Padding="16">
        <StackPanel>
            <!-- Success Icon -->
            <materialDesign:PackIcon Kind="CheckDecagram"
                                    Width="48"
                                    Height="48"
                                    Foreground="#4CAF50"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12"/>

            <!-- Title -->
            <TextBlock Text="Refund Processed Successfully"
                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                      HorizontalAlignment="Center"
                      FontWeight="SemiBold"
                      Margin="0,0,0,16"/>

            <!-- Info Grid -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sale Number -->
                <materialDesign:PackIcon Kind="ReceiptText"
                                        Grid.Row="0" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Sale Number"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding SaleNumber}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Refund Amount -->
                <materialDesign:PackIcon Kind="CashRefund"
                                        Grid.Row="1" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Refund Amount"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding FormattedRefundAmount}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"
                              Foreground="#4CAF50"
                              FontSize="15"/>
                </StackPanel>

                <!-- Time -->
                <materialDesign:PackIcon Kind="ClockOutline"
                                        Grid.Row="2" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="Processed At"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding ProcessedAt}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>
            </Grid>

            <!-- Success Message -->
            <Border Background="#E8F5E9"
                    CornerRadius="4"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Foreground="#4CAF50"/>
                    <TextBlock Text="The refund has been credited back to the customer"
                              Style="{StaticResource MaterialDesignBody2TextBlock}"
                              VerticalAlignment="Center"
                              Foreground="#2E7D32"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
    
</UserControl>
