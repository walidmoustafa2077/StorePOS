<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.CashOperationSuccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            Padding="16">
        <StackPanel>
            <!-- Success Icon -->
            <materialDesign:PackIcon Width="48"
                                     Height="48"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,12">
                <materialDesign:PackIcon.Style>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Foreground"
                                Value="{DynamicResource PrimaryHueMidBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OperationType}"
                                         Value="Drop">
                                <Setter Property="Kind"
                                        Value="CashMinus" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OperationType}"
                                         Value="Add">
                                <Setter Property="Kind"
                                        Value="CashPlus" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>

            <!-- Title -->
            <TextBlock HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
                        <Setter Property="FontWeight"
                                Value="SemiBold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OperationType}"
                                         Value="Drop">
                                <Setter Property="Text"
                                        Value="Cash Drop Successful" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OperationType}"
                                         Value="Add">
                                <Setter Property="Text"
                                        Value="Cash Add Successful" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Info Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Amount -->
                <materialDesign:PackIcon Kind="CashMultiple"
                                         Grid.Row="0"
                                         Grid.Column="0"
                                         Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,8"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Amount {0}">
                                <Binding Path="OperationType" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding FormattedAmount}"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               FontSize="15" />
                </StackPanel>

                <!-- Wallet -->
                <materialDesign:PackIcon Kind="Wallet"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,8"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="WalletLabel" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WalletName}"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               FontWeight="Medium" />
                </StackPanel>

                <!-- Reason -->
                <materialDesign:PackIcon Kind="InformationOutline"
                                         Grid.Row="2"
                                         Grid.Column="0"
                                         Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,8"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,8">
                    <TextBlock Text="Reason"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="{Binding Reason}"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               FontWeight="Medium"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- New Balance -->
                <materialDesign:PackIcon Kind="Cash"
                                         Grid.Row="3"
                                         Grid.Column="0"
                                         Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,8"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <StackPanel Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,8">
                    <TextBlock Text="New Balance"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="{Binding FormattedNewBalance}"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               FontWeight="Medium"
                               FontSize="14" />
                </StackPanel>

                <!-- Time -->
                <materialDesign:PackIcon Kind="ClockOutline"
                                         Grid.Row="4"
                                         Grid.Column="0"
                                         Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <StackPanel Grid.Row="4"
                            Grid.Column="1">
                    <TextBlock Text="Time"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="{Binding Time}"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               FontWeight="Medium" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>

</UserControl>
