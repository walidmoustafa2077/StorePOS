<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.StartShiftDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StorePOS.Client.Wpf.Converters"
             xmlns:behaviors="clr-namespace:StorePOS.Client.Wpf.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="600">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <materialDesign:Card Background="{DynamicResource MaterialDesign.Brush.Background}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="ClockTimeEight"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Enter cashier information and starting account balances for the new shift."
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Opacity="0.7" />
                </StackPanel>

                <!-- Cashier Information -->
                <materialDesign:Card Grid.Row="1"
                                     Padding="16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Text="Cashier Information"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBox Text="{Binding CashierName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Cashier Name *"
                                         MaxLength="50"
                                         FontSize="14">
                                    <i:Interaction.Behaviors>
                                        <behaviors:SelectAllTextOnFocusBehavior />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBox Text="{Binding ShiftNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Shift Notes (Optional)"
                                         MaxLength="200"
                                         FontSize="14">
                                    <i:Interaction.Behaviors>
                                        <behaviors:SelectAllTextOnFocusBehavior />
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <!-- Validation message -->
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsValidInput, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Account Balances -->
                <materialDesign:Card Grid.Row="2"
                                     Padding="16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,16">
                            <TextBlock Text="Starting Account Balances"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       VerticalAlignment="Center" />
                            <Button Content="Reset to Defaults"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ResetBalancesCommand}"
                                    Margin="16,0,0,0"
                                    Padding="12,4"
                                    FontSize="12" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AccountBalances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,8"
                                                         Padding="16"
                                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                                         Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Account Icon and Info -->
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                         Width="24"
                                                                         Height="24"
                                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,12,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AccountName}"
                                                               FontWeight="Medium"
                                                               FontSize="14" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                               Opacity="0.7" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Balance Input -->
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="$"
                                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                                                <TextBox Text="{Binding StartingBalance, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         Width="120"
                                                         FontSize="16"
                                                         FontWeight="Medium"
                                                         HorizontalContentAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Quick Cash Amount Buttons -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Quick Cash Amounts:"
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="$50"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding SetQuickCashAmountCommand}"
                                        CommandParameter="50"
                                        Margin="0,0,8,0"
                                        Padding="12,6" />
                                <Button Content="$100"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding SetQuickCashAmountCommand}"
                                        CommandParameter="100"
                                        Margin="0,0,8,0"
                                        Padding="12,6" />
                                <Button Content="$200"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding SetQuickCashAmountCommand}"
                                        CommandParameter="200"
                                        Margin="0,0,8,0"
                                        Padding="12,6" />
                                <Button Content="$500"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding SetQuickCashAmountCommand}"
                                        CommandParameter="500"
                                        Padding="12,6" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Summary -->
                <materialDesign:Card Grid.Row="3"
                                     Padding="16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Calculator"
                                                 Width="24"
                                                 Height="24"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="Total Starting Balance"
                                       FontWeight="Medium"
                                       FontSize="14" />
                            <TextBlock Text="{Binding FormattedTotalBalance}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{Binding SecondaryButtonText}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding CancelCommand}"
                            Height="34"
                            Margin="0,0,8,0"
                            Padding="24,10"
                            MinWidth="120" />

                    <Button Content="{Binding PrimaryButtonText}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding StartShiftCommand}"
                            IsDefault="True"
                            Height="34"
                            Padding="24,10"
                            MinWidth="120"
                            Background="#4CAF50" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

    </materialDesign:Card>
</UserControl>