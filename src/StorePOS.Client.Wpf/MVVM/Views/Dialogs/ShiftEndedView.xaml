<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.ShiftEndedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            Padding="16">
        <StackPanel>
            <!-- Success Icon -->
            <materialDesign:PackIcon Kind="CheckCircleOutline"
                                    Width="48"
                                    Height="48"
                                    Foreground="#4CAF50"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12"/>

            <!-- Title -->
            <TextBlock Text="Shift Ended Successfully"
                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                      HorizontalAlignment="Center"
                      FontWeight="SemiBold"
                      Margin="0,0,0,16"/>

            <!-- Info Grid -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Shift Number -->
                <materialDesign:PackIcon Kind="Counter"
                                        Grid.Row="0" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Shift Number"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding ShiftNumber}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Total Duration -->
                <materialDesign:PackIcon Kind="ClockOutline"
                                        Grid.Row="1" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Total Duration"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding Duration}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Total Transactions -->
                <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                        Grid.Row="2" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Total Transactions"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding TransactionCount}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Final Balance -->
                <materialDesign:PackIcon Kind="CashMultiple"
                                        Grid.Row="3" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <TextBlock Text="Final Balance"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding FormattedFinalBalance}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"
                              Foreground="{DynamicResource PrimaryHueMidBrush}"
                              FontSize="15"/>
                </StackPanel>
            </Grid>

            <!-- Info Cards -->
            <StackPanel>
                <!-- Cash Removed Notice -->
                <Border Background="#FFF3E0"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Foreground="#FF9800"/>
                        <TextBlock Text="All cash has been removed from till"
                                  Style="{StaticResource MaterialDesignBody2TextBlock}"
                                  VerticalAlignment="Center"
                                  Foreground="#E65100"/>
                    </StackPanel>
                </Border>

                <!-- Next Steps -->
                <Border Background="#E8F5E9"
                        CornerRadius="4"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowRight"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Foreground="#4CAF50"/>
                        <TextBlock Text="Start a new shift to resume operations"
                                  Style="{StaticResource MaterialDesignBody2TextBlock}"
                                  VerticalAlignment="Center"
                                  Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
    
</UserControl>
