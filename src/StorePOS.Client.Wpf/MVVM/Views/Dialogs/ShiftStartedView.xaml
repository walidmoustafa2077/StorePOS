<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.ShiftStartedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            Padding="16">
        <StackPanel>
            <!-- Success Icon -->
            <materialDesign:PackIcon Kind="CheckCircle"
                                    Width="48"
                                    Height="48"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12"/>

            <!-- Title -->
            <TextBlock Text="Shift Started Successfully"
                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                      HorizontalAlignment="Center"
                      FontWeight="SemiBold"
                      Margin="0,0,0,16"/>

            <!-- Info Grid -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cashier -->
                <materialDesign:PackIcon Kind="Account"
                                        Grid.Row="0" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Cashier"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding CashierName}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Shift Number -->
                <materialDesign:PackIcon Kind="Counter"
                                        Grid.Row="1" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Shift Number"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding ShiftNumber}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Starting Balance -->
                <materialDesign:PackIcon Kind="CashMultiple"
                                        Grid.Row="2" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Starting Balance"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding FormattedStartingBalance}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"
                              Foreground="{DynamicResource PrimaryHueMidBrush}"
                              FontSize="15"/>
                </StackPanel>

                <!-- Start Time -->
                <materialDesign:PackIcon Kind="ClockOutline"
                                        Grid.Row="3" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <TextBlock Text="Started At"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding StartedAt}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>
            </Grid>

            <!-- Motivational Message -->
            <Border Background="{DynamicResource MaterialDesignDivider}"
                    CornerRadius="4"
                    Padding="12,8">
                <TextBlock Text="Good luck with your shift! 🚀"
                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                          HorizontalAlignment="Center"
                          FontStyle="Italic"
                          Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </Border>
        </StackPanel>
    </Border>
    
</UserControl>
