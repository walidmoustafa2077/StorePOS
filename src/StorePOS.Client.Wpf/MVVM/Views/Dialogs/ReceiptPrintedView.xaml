<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.ReceiptPrintedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            Padding="16">
        <StackPanel>
            <!-- Success Icon -->
            <materialDesign:PackIcon Kind="Printer"
                                    Width="48"
                                    Height="48"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12"/>

            <!-- Title -->
            <TextBlock Text="Receipt Sent to Printer"
                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                      HorizontalAlignment="Center"
                      FontWeight="SemiBold"
                      Margin="0,0,0,16"/>

            <!-- Info Grid -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sale Number -->
                <materialDesign:PackIcon Kind="ReceiptText"
                                        Grid.Row="0" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,8"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Sale Number"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding SaleNumber}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Time -->
                <materialDesign:PackIcon Kind="ClockOutline"
                                        Grid.Row="1" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Print Time"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding PrintTime}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>
            </Grid>

            <!-- Info Message -->
            <Border Background="{DynamicResource MaterialDesignDivider}"
                    CornerRadius="4"
                    Padding="12,8">
                <TextBlock Text="The receipt is being printed..."
                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                          HorizontalAlignment="Center"
                          FontStyle="Italic"
                          Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </Border>
        </StackPanel>
    </Border>
    
</UserControl>
