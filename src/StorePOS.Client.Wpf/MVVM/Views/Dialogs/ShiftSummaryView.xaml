<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.ShiftSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Border Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8"
            Padding="16">
        <StackPanel>
            <!-- Icon -->
            <materialDesign:PackIcon Kind="ChartBox"
                                    Width="48"
                                    Height="48"
                                    Foreground="{DynamicResource SecondaryHueMidBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8"/>

            <!-- Title -->
            <TextBlock Text="Shift Summary"
                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                      HorizontalAlignment="Center"
                      FontWeight="SemiBold"
                      Margin="0,0,0,12"/>

            <!-- Info Grid -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Shift Number -->
                <materialDesign:PackIcon Kind="Counter"
                                        Grid.Row="0" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                    <TextBlock Text="Shift Number"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding ShiftNumber}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Cashier -->
                <materialDesign:PackIcon Kind="Account"
                                        Grid.Row="1" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                    <TextBlock Text="Cashier"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding CashierName}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Duration -->
                <materialDesign:PackIcon Kind="ClockOutline"
                                        Grid.Row="2" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                    <TextBlock Text="Duration"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding Duration}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Transactions -->
                <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                        Grid.Row="3" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                    <TextBlock Text="Transactions"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding TransactionCount}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Separator -->
                <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                          Margin="0,0,0,4"
                          Background="{DynamicResource MaterialDesignDivider}"/>

                <!-- Starting Balance -->
                <materialDesign:PackIcon Kind="CashMultiple"
                                        Grid.Row="5" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,6">
                    <TextBlock Text="Starting Balance"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding FormattedStartingBalance}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"/>
                </StackPanel>

                <!-- Current Balance -->
                <materialDesign:PackIcon Kind="Cash"
                                        Grid.Row="6" Grid.Column="0"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <StackPanel Grid.Row="6" Grid.Column="1">
                    <TextBlock Text="Current Balance"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding FormattedCurrentBalance}"
                              Style="{StaticResource MaterialDesignBody1TextBlock}"
                              FontWeight="Medium"
                              FontSize="15"/>
                </StackPanel>
            </Grid>

            <!-- Balance Change Card -->
            <Border CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPositiveChange}" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPositiveChange}" Value="False">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPositiveChange}" Value="True">
                                        <Setter Property="Kind" Value="TrendingUp"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPositiveChange}" Value="False">
                                        <Setter Property="Kind" Value="TrendingDown"/>
                                        <Setter Property="Foreground" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody1TextBlock}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPositiveChange}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPositiveChange}" Value="False">
                                        <Setter Property="Foreground" Value="#F44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Balance Change: "/>
                        <Run Text="{Binding FormattedBalanceChange}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Confirmation Message -->
            <TextBlock Text="Are you sure you want to end this shift?"
                      Style="{StaticResource MaterialDesignBody1TextBlock}"
                      HorizontalAlignment="Center"
                      TextWrapping="Wrap"
                      FontStyle="Italic"/>
        </StackPanel>
    </Border>
    
</UserControl>
