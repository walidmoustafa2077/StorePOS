<UserControl x:Class="StorePOS.Client.Wpf.MVVM.Views.Dialogs.RefundDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StorePOS.Client.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Process Refund"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <!-- Sale Information -->
        <materialDesign:Card Grid.Row="1"
                             Padding="16"
                             Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Sale #:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,4" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding SaleNumber}"
                           Margin="0,0,16,4" />

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Date:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,4" />
                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Text="{Binding SaleDate}"
                           Margin="0,0,0,4" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Total:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding TotalAmount}"
                           Foreground="#4CAF50"
                           FontWeight="SemiBold"
                           Margin="0,0,0,0" />
            </Grid>
        </materialDesign:Card>

        <!-- Instructions -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="InformationOutline"
                                     Width="20"
                                     Height="20"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
            <TextBlock Text="Select items to refund and specify quantities"
                       FontSize="13"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Items List -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header with Select/Deselect All -->
                <Border Grid.Row="0"
                        Background="{DynamicResource MaterialDesign.Brush.Background.Light}"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Sale Items"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding SelectAllCommand}"
                                    Content="Select All"
                                    Height="28"
                                    Padding="12,4"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding DeselectAllCommand}"
                                    Content="Deselect All"
                                    Height="28"
                                    Padding="12,4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Items ScrollViewer -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="300">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Margin="4"
                                                     Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  IsEnabled="{Binding MaxRefundableQuantity, Converter={StaticResource GreaterThanZeroConverter}}" />

                                        <!-- Product Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ProductName}"
                                                       FontWeight="SemiBold" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           FontSize="12"
                                                           Opacity="0.7">
                                                    <Run Text="Qty: " />
                                                    <Run Text="{Binding OriginalQuantity, Mode=OneWay}" />
                                                    <Run Text=" | Unit Price: " />
                                                    <Run Text="{Binding FormattedUnitPrice, Mode=OneWay}" />
                                                    <Run Text=" | Total: " />
                                                    <Run Text="{Binding FormattedLineTotal, Mode=OneWay}"
                                                         FontWeight="SemiBold" />
                                                </TextBlock>
                                            </Grid>

                                            <TextBlock FontSize="11"
                                                       Foreground="#FF9800"
                                                       Margin="0,2,0,0">
                                                <Run Text="Already Refunded: " />
                                                <Run Text="{Binding QuantityAlreadyRefunded, Mode=OneWay}" />
                                                <Run Text=" | Available: " />
                                                <Run Text="{Binding MaxRefundableQuantity, Mode=OneWay}"
                                                     FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Refund Quantity Input -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding IsSelected}">
                                            <TextBlock Text="Refund Qty:"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,8,0" />
                                            <TextBox Text="{Binding RefundQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Width="60"
                                                     Height="32"
                                                     Padding="8,4"
                                                     VerticalContentAlignment="Center"
                                                     Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding FormattedRefundAmount, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#4CAF50"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       MinWidth="60"
                                                       TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Refund Reason -->
        <TextBox Grid.Row="4"
                 Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Refund Reason (Optional)"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 MaxLength="500"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalContentAlignment="Top"
                 Margin="0,0,0,16" />

        <!-- Total Refund Amount -->
        <materialDesign:Card Grid.Row="5"
                             Background="{DynamicResource MaterialDesign.Brush.Primary}"
                             Padding="16"
                             Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="Total Refund Amount:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding FormattedTotalRefundAmount}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </materialDesign:Card>

        <!-- Action Buttons -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,8,0" />

            <Button Grid.Column="2"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding ConfirmCommand}"
                    Height="36">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CashRefund"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="Process Refund" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
